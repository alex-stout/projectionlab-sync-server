# NOTE: docker-compose interpolates $VAR / ${VAR} in values loaded from this file.
# If your password/secret contains a literal `$`, escape it as `$$` or compose will
# silently replace `$whatever` with an empty string.
SIMPLEFIN_ACCESS_URL=https://user:pass@bridge.simplefin.org/simplefin
PROJECTIONLAB_EMAIL=you@example.com
PROJECTIONLAB_PASSWORD=change-me
PROJECTIONLAB_API_KEY=change-me
# Leave unset if you don't have OTP enabled.
PROJECTIONLAB_TOTP_SECRET=change-me
# Cron expression (local time, i.e. TZ below) for when the sync runs.
SCHEDULE_CRON=0 0 * * *
TZ=UTC
# comma-separated simplefin_id:projectionlab_id pairs
MAPPINGS=ACT-example-1:pl-account-id-1
